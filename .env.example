# Ragent Python 示例环境变量
# 复制为 .env 后按个人情况修改；不要把真实 API Key 提交到仓库。

# ========================================
# LLM 模型配置
# ========================================
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
# 独立于 LLM 的 Embedding 配置（可选，未配置时自动继承上方通用大模型配置）
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=


# 备用模型配置（可选）
SILICONFLOW_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# ========================================
# 应用与账号
# ========================================
DEBUG=false
APP_NAME="Ragent Python API"
APP_VERSION=0.3.0
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
JWT_SECRET=replace-with-at-least-32-random-characters

# ========================================
# Docker 内部服务地址
# ========================================
DATABASE_URL=mysql+pymysql://root:root@mysql:3306/ragent?charset=utf8mb4
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
VECTOR_BACKEND=milvus
MILVUS_URI=http://milvus:19530

# ========================================
# 运维监控配置
# ========================================
MONITORING_ENABLED=true
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093
MONITORING_TIMEOUT_SECONDS=5
SERVERS_CONFIG_PATH=/app/config/servers.yml
MONITORING_CONFIG_PATH=/app/config/monitoring.yml

# ========================================
# 运维 Agent Docker 白名单工具
# ========================================
AGENT_EXECUTOR_ENABLED=false
AGENT_COMPOSE_DIR=/app
AGENT_COMPOSE_PROJECT=ragent-python

# ========================================
# OpenAI Evals 外部评估配置
# ========================================
OPENAI_EVALS_ENABLED=false
OPENAI_EVALS_API_KEY=
# OPENAI_EVALS_API_BASE=https://api.openai.com/v1
# OPENAI_EVALS_GRADER_MODEL=o3-mini

# ========================================
# LangSmith 链路追踪与评估反馈
# ========================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ragent-python
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
