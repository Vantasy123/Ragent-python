# Ragent Python 智能求职 Agent 示例环境变量
# 复制为 .env 后按个人情况修改；不要把真实 API Key 提交到代码仓库。

# ========================================
# LLM 模型配置 (支持 Qwen / DeepSeek / OpenAI / SiliconFlow)
# ========================================
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# 独立于 LLM 的 Embedding 配置（可选，未配置时自动继承上方通用大模型配置）
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# 备用模型配置（可选）
SILICONFLOW_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# ========================================
# 应用与安全账号
# ========================================
DEBUG=false
APP_NAME="Ragent Job Agent API"
APP_VERSION=1.0.0
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
JWT_SECRET=replace-with-at-least-32-random-characters-for-jwt-security

# ========================================
# 存储与中间件连接地址 (Docker 内部默认)
# ========================================
DATABASE_URL=mysql+pymysql://root:root@mysql:3306/ragent?charset=utf8mb4
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
VECTOR_BACKEND=milvus
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=

# ========================================
# 并发与频控策略
# ========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
CHAT_MAX_CONCURRENCY_PER_USER=3

# ========================================
# 大模型与智能体评测中心 (OpenAI Evals & LangSmith)
# ========================================
OPENAI_EVALS_ENABLED=false
OPENAI_EVALS_API_KEY=
# OPENAI_EVALS_API_BASE=https://api.openai.com/v1
# OPENAI_EVALS_GRADER_MODEL=gpt-4o-mini

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ragent-job-agent
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
